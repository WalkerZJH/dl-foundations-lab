      },
      "variants": [
        {"id": "A1-AB-NORM-001", "kind": "solver", "model": "fully_connected", "hidden_dims": [100, 100], "normalization": null, "dropout_keep_ratio": 1.0, "update_rule": "adam", "learning_rate": 0.001, "weight_scale": 0.05, "reg": 0.1},
        {"id": "A1-AB-NORM-002", "kind": "solver", "model": "fully_connected", "hidden_dims": [100, 100], "normalization": "batchnorm", "dropout_keep_ratio": 1.0, "update_rule": "adam", "learning_rate": 0.001, "weight_scale": 0.05, "reg": 0.1},
        {"id": "A1-AB-NORM-003", "kind": "solver", "model": "fully_connected", "hidden_dims": [100, 100], "normalization": "layernorm", "dropout_keep_ratio": 1.0, "update_rule": "adam", "learning_rate": 0.001, "weight_scale": 0.05, "reg": 0.1},
        {"id": "A1-AB-NORM-004", "kind": "solver", "model": "fully_connected", "hidden_dims": [100, 100], "normalization": null, "dropout_keep_ratio": 0.8, "update_rule": "adam", "learning_rate": 0.001, "weight_scale": 0.05, "reg": 0.1}
