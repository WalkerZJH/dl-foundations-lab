      },
      "variants": [
        {"id": "A1-AB-OPT-001", "kind": "solver", "model": "two_layer", "update_rule": "sgd", "learning_rate": 0.001, "hidden_dim": 100, "weight_scale": 0.01, "reg": 0.1},
