{
  "run_id": "ag_transformer_encoder_small",
  "dataset": "ag_news",
  "model": "transformer_encoder",
  "seed": 42,
  "device": "cuda_if_available",
  "lowercase": true,
  "vocab_size": 50000,
  "min_freq": 2,
  "max_seq_len": 256,
  "padding_idx": 0,
  "embedding_dim": 128,
  "hidden_dim": 256,
  "num_filters": 128,
  "kernel_sizes": [
    3,
    4,
    5
  ],
  "num_layers": 2,
  "dropout": 0.1,
  "batch_size": 128,
  "num_workers": 0,
  "optimizer": "adamw",
  "learning_rate": 0.0005,
  "weight_decay": 0.01,
  "scheduler": "cosine_with_warmup",
  "epochs": 20,
  "early_stopping": {
    "monitor": "val_acc",
    "patience": 5
  },
  "gradient_clip_norm": null,
  "num_heads": 4,
  "ffn_dim": 512,
  "warmup_ratio": 0.1,
  "label_smoothing": 0.05
}